@model PRN222_CinemaManagement.ViewModels.CounterMovieScreeningsViewModel
@using PRN222_CinemaManagement.Constants
@{
    ViewData["Title"] = $"Suất chiếu - {Model.Movie.Title}";
    var movie = Model.Movie;

    string AgeBadgeClass(string rating) => rating switch
    {
        "P" or "K" => "bg-success",
        "T13" => "bg-info text-dark",
        "T16" => "bg-warning text-dark",
        "T18" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container-fluid px-0">
    @* Nút quay lại *@
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách phim
        </a>
    </div>

    @* Banner thông tin phim *@
    <div class="card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="card-body p-4 bg-light">
            <div class="row g-4 align-items-center">
                <div class="col-md-2 col-sm-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                    {
                        <img src="@movie.PosterUrl" alt="Poster @movie.Title" class="img-fluid rounded shadow-sm" style="max-height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center mx-auto" style="width: 140px; height: 190px;">
                            <span class="small fw-bold">CINEMA</span>
                        </div>
                    }
                </div>
                <div class="col-md-10 col-sm-9">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge @AgeBadgeClass(movie.AgeRating) fs-6">@movie.AgeRating</span>
                        <span class="badge bg-dark fs-6"><i class="bi bi-clock me-1"></i>@movie.DurationMinutes phút</span>
                        @if (movie.Status == "Upcoming")
                        {
                            <span class="badge bg-warning text-dark fs-6"><i class="bi bi-stars"></i> Vé sớm (Presale)</span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">Đang chiếu (Showing)</span>
                        }
                    </div>

                    <h2 class="text-primary fw-bold mb-2">@movie.Title</h2>

                    @if (movie.MovieGenres.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var mg in movie.MovieGenres)
                            {
                                <span class="badge bg-white text-secondary border fw-normal">@mg.Genre.GenreName</span>
                            }
                        </div>
                    }

                    <p class="text-muted small mb-0" style="max-width: 800px;">
                        @(string.IsNullOrWhiteSpace(movie.Description) ? "Không có mô tả chi tiết." : movie.Description)
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* Bộ lọc theo ngày chiếu *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="fw-bold mb-0 text-dark">
            <i class="bi bi-calendar3 me-1"></i> Lịch chiếu khả dụng tại quầy
        </h4>
        <span class="badge bg-primary px-3 py-2 fs-6 fw-normal">
            @Model.Screenings.Count suất chiếu đang nhận đặt vé
        </span>
    </div>

    @if (Model.AvailableDates.Count > 1)
    {
        <div class="mb-4">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold me-1">Chọn ngày chiếu:</span>
                <a asp-action="Screenings" asp-route-movieId="@movie.MovieId"
                   class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedDate) ? "btn-primary" : "btn-outline-secondary")">
                    Tất cả các ngày
                </a>
                @foreach (var date in Model.AvailableDates)
                {
                    string dateStr = date.ToString("yyyy-MM-dd");
                    bool isSelected = Model.SelectedDate == dateStr;
                    <a asp-action="Screenings" asp-route-movieId="@movie.MovieId" asp-route-showDate="@dateStr"
                       class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary")">
                        @date.ToString("dd/MM/yyyy") (@(date == DateOnly.FromDateTime(DateTime.UtcNow.AddHours(BookingConstants.VietnamUtcOffsetHours)) ? "Hôm nay" : date.DayOfWeek.ToString()))
                    </a>
                }
            </div>
        </div>
    }

    @* Danh sách suất chiếu *@
    @if (Model.Screenings.Count == 0)
    {
        <div class="card shadow-sm border-0 py-5 text-center">
            <div class="card-body">
                <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3 mb-1">Không có suất chiếu khả dụng cho ngày đã chọn</h5>
                <p class="text-muted small mb-3">Vui lòng chọn ngày khác hoặc quay lại danh sách tất cả suất chiếu của phim.</p>
                <a asp-action="Screenings" asp-route-movieId="@movie.MovieId" class="btn btn-outline-primary btn-sm">Xem tất cả các ngày</a>
            </div>
        </div>
    }
    else
    {
        @* Gom nhóm theo ngày chiếu *@
        @foreach (var dayGroup in Model.Screenings.GroupBy(s => DateOnly.FromDateTime(s.StartAt.AddHours(BookingConstants.VietnamUtcOffsetHours))))
        {
            var dayDate = dayGroup.Key;
            bool isToday = dayDate == DateOnly.FromDateTime(DateTime.UtcNow.AddHours(BookingConstants.VietnamUtcOffsetHours));

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar-check text-primary me-2"></i>
                        Ngày: @dayDate.ToString("dd/MM/yyyy")
                        @if (isToday)
                        {
                            <span class="badge bg-success ms-2 fw-normal">Hôm nay</span>
                        }
                    </h5>
                    <span class="text-muted small">@dayGroup.Count() suất chiếu</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        @foreach (var sc in dayGroup)
                        {
                            var vnStart = sc.StartAt.AddHours(BookingConstants.VietnamUtcOffsetHours);
                            var vnEnd = sc.EndAt.AddHours(BookingConstants.VietnamUtcOffsetHours);

                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="border rounded p-3 h-100 d-flex flex-column justify-content-between bg-white hover-shadow transition-hover">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge bg-dark fs-6 px-2 py-1">
                                                <i class="bi bi-door-open me-1"></i> @sc.Auditorium.Name
                                            </span>
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                                @sc.Status
                                            </span>
                                        </div>

                                        <div class="my-2">
                                            <div class="fs-4 fw-bold text-primary">
                                                @vnStart.ToString("HH:mm") <span class="fs-6 text-muted font-monospace">→ @vnEnd.ToString("HH:mm")</span>
                                            </div>
                                            <div class="text-muted small">
                                                Thời lượng: @movie.DurationMinutes phút
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center my-2 pt-2 border-top">
                                            <span class="small text-muted">Giá vé cơ bản từ:</span>
                                            <span class="fw-bold text-danger fs-5">@sc.BasePrice.ToString("N0") đ</span>
                                        </div>
                                    </div>

                                    <div class="pt-3 border-top mt-2">
                                        <a asp-action="SelectSeats" asp-route-screeningId="@sc.ScreeningId"
                                           class="btn btn-primary w-100 fw-semibold">
                                            <i class="bi bi-grid-3x3-gap me-1"></i> Chọn ghế & Bán vé
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.375rem 0.75rem rgba(0,0,0,0.1) !important;
    }
</style>
