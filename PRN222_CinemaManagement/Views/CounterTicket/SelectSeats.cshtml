@model IEnumerable<PRN222_CinemaManagement.Models.Entities.ScreeningSeat>
@{
    ViewData["Title"] = "Bán vé & Bắp nước tại quầy";
    var screening = ViewBag.Screening as PRN222_CinemaManagement.Models.Entities.Screening;
    var concessionItems = ViewBag.ConcessionItems as List<PRN222_CinemaManagement.Models.Entities.ConcessionItem> ?? new();
    var rows = Model.GroupBy(s => s.Seat.RowLabel).OrderBy(g => g.Key).ToList();
    int? holdingBookingId = ViewBag.HoldingBookingId as int?;
    DateTime? holdingExpiresAt = ViewBag.HoldingExpiresAt as DateTime?;
}

<link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />

<div class="container my-4">
    @* Thanh điều hướng và tiêu đề *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách suất chiếu
            </a>
            <h3 class="text-primary mb-0"><i class="bi bi-cart4"></i> Bán vé & Bắp nước tại quầy</h3>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary">Kênh: Quầy thu ngân</span>
            @* Đồng hồ đếm ngược giữ ghế 5 phút *@
            <div class="badge bg-dark fs-6 px-3 py-2 border border-warning" id="countdownContainer" style="@(holdingExpiresAt != null ? "display: inline-flex;" : "display: none;")">
                <i class="bi bi-stopwatch text-warning me-1"></i> Giữ ghế: <span id="countdownTimer" class="font-monospace text-warning fw-bold">05:00</span>
            </div>
            <span id="signalrStatusBadge" class="badge bg-light text-muted border">
                <i class="bi bi-broadcast"></i> Đang kết nối trực tiếp...
            </span>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.location.reload()" title="Tải lại sơ đồ ghế mới nhất">
                <i class="bi bi-arrow-clockwise"></i> Tải lại sơ đồ
            </button>
        </div>
    </div>

    @* Thông báo lỗi nếu có *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Banner thông tin suất chiếu *@
    @if (screening != null)
    {
        var vnStart = screening.StartAt.ToLocalTime();
        var vnEnd = screening.EndAt.ToLocalTime();
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-body bg-light">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <span class="badge bg-primary mb-1">Mã suất: #@screening.ScreeningId</span>
                        @if (screening.Movie.Status == "Upcoming")
                        {
                            <span class="badge bg-warning text-dark mb-1"><i class="bi bi-stars"></i> Vé sớm (Presale)</span>
                        }
                        <h4 class="fw-bold text-dark mb-1">@screening.Movie.Title</h4>
                        <small class="text-muted">
                            Thời lượng: @screening.Movie.DurationMinutes phút | Giới hạn: @screening.Movie.AgeRating
                        </small>
                    </div>
                    <div class="col-md-4">
                        <div class="fw-semibold text-secondary">
                            <i class="bi bi-geo-alt-fill text-danger"></i> @screening.Auditorium.Name
                        </div>
                        <div class="fw-bold text-dark">
                            <i class="bi bi-clock-fill text-primary"></i> @vnStart.ToString("HH:mm") - @vnEnd.ToString("HH:mm")
                        </div>
                        <small class="text-muted">Ngày: @vnStart.ToString("dd/MM/yyyy")</small>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <div class="text-muted small">Giá cơ bản:</div>
                        <div class="fw-bold fs-5 text-success">@screening.BasePrice.ToString("N0") đ</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <form method="post" asp-action="Sell" id="sellForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="formToken" value="@ViewBag.FormToken" />
        <input type="hidden" name="screeningId" value="@(screening?.ScreeningId ?? 0)" />
        <input type="hidden" name="holdingBookingId" id="holdingBookingIdInput" value="@(holdingBookingId?.ToString() ?? "")" />

        <div class="row g-4">
            @* Cột trái: Sơ đồ ghế + Danh sách bắp nước *@
            <div class="col-lg-8">
                @* 1. SƠ ĐỒ GHẾ - ĐỒNG BỘ 100% VỚI BOOKING ONLINE CỦA BÁCH *@
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <div class="seat-legend">
                            <span><i class="seat-key available"></i>Trống</span>
                            <span><i class="seat-key mine"></i>Quầy đang chọn</span>
                            <span><i class="seat-key held"></i>Người khác giữ</span>
                            <span><i class="seat-key sold"></i>Đã bán</span>
                            <span><i class="seat-key blocked"></i>Không sử dụng</span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        @* Mô phỏng Màn hình chiếu cong chuẩn rạp *@
                        <div class="cinema-screen mb-4">MÀN HÌNH CHIẾU</div>

                        @* Ma trận ghế - Sử dụng cùng cấu trúc Flexbox và CSS class của Customer *@
                        <div class="seat-map-scroll">
                            <div id="seat-map" class="seat-map">
                                @if (rows.Count == 0)
                                {
                                    <div class="text-muted text-center py-4">Suất chiếu chưa có ghế mở bán.</div>
                                }
                                else
                                {
                                    @foreach (var rowGroup in rows)
                                    {
                                        <div class="seat-row" data-row="@rowGroup.Key">
                                            <span class="seat-row-label">@rowGroup.Key</span>

                                            @foreach (var ss in rowGroup.OrderBy(s => s.Seat.SeatNumber))
                                            {
                                                string seatCode = $"{ss.Seat.RowLabel}{ss.Seat.SeatNumber}";
                                                string typeName = ss.Seat.SeatType.TypeName;
                                                bool isCouple = typeName.Equals("Couple", StringComparison.OrdinalIgnoreCase);
                                                string typeDisplay = isCouple ? "Đôi" : (typeName.Equals("Standard", StringComparison.OrdinalIgnoreCase) ? "Thường" : typeName);

                                                bool isHeldByThisBooking = (holdingBookingId.HasValue
                                                    && ss.Status == PRN222_CinemaManagement.Constants.BookingConstants.ScreeningSeatStatuses.Held
                                                    && ss.HeldByBookingId == holdingBookingId.Value);

                                                string stateClass;
                                                string stateText;
                                                bool isInteractive = false;

                                                if (isHeldByThisBooking)
                                                {
                                                    stateClass = "mine";
                                                    stateText = "Quầy đang chọn";
                                                    isInteractive = true;
                                                }
                                                else if (ss.Status == "Available")
                                                {
                                                    stateClass = "available";
                                                    stateText = "Trống";
                                                    isInteractive = true;
                                                }
                                                else if (ss.Status == "Held")
                                                {
                                                    stateClass = "held";
                                                    stateText = "Người khác giữ";
                                                }
                                                else if (ss.Status == "Sold")
                                                {
                                                    stateClass = "sold";
                                                    stateText = "Đã bán";
                                                }
                                                else
                                                {
                                                    stateClass = "blocked";
                                                    stateText = "Không sử dụng";
                                                }

                                                <button type="button"
                                                        id="seat-btn-@ss.ScreeningSeatId"
                                                        class="seat-button @stateClass @(isCouple ? "couple" : "")"
                                                        data-seat-id="@ss.ScreeningSeatId"
                                                        data-price="@ss.Price"
                                                        data-code="@seatCode"
                                                        data-row="@ss.Seat.RowLabel"
                                                        data-num="@ss.Seat.SeatNumber"
                                                        data-type="@typeName"
                                                        data-type-display="@typeDisplay"
                                                        @(isInteractive ? "" : "disabled")
                                                        aria-pressed="@(isHeldByThisBooking ? "true" : "false")"
                                                        title="Ghế @seatCode · @typeDisplay · @ss.Price.ToString("N0") đ · @stateText">
                                                    @seatCode
                                                    <small>@typeDisplay</small>
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        @* Hidden inputs chứa danh sách seatIds khi submit form *@
                        <div id="hiddenSeatInputs">
                            @foreach (var ss in Model)
                            {
                                bool isHeldByThisBooking = (holdingBookingId.HasValue
                                    && ss.Status == PRN222_CinemaManagement.Constants.BookingConstants.ScreeningSeatStatuses.Held
                                    && ss.HeldByBookingId == holdingBookingId.Value);
                                if (isHeldByThisBooking)
                                {
                                    <input type="hidden" name="seatIds" value="@ss.ScreeningSeatId" id="hidden-seat-@ss.ScreeningSeatId" />
                                }
                            }
                        </div>
                    </div>
                </div>

                @* 2. DANH SÁCH BẮP NƯỚC (TÙY CHỌN - TRONG CÙNG FORM) *@
                @if (concessionItems.Count > 0)
                {
                    <div class="card shadow-sm border-info">
                        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark"><i class="bi bi-cup-straw text-primary me-1"></i> Bắp nước mua kèm (Tùy chọn)</span>
                            <small class="badge bg-secondary">Xuất hóa đơn bắp nước riêng</small>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-end" style="width: 120px;">Đơn giá</th>
                                            <th class="text-center" style="width: 90px;">Tồn kho</th>
                                            <th class="text-center" style="width: 140px;">Số lượng</th>
                                            <th class="text-end" style="width: 130px;">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < concessionItems.Count; i++)
                                        {
                                            var item = concessionItems[i];
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="concessions[@i].ItemId" value="@item.ConcessionItemId" />
                                                    <div class="fw-semibold">@item.Name</div>
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.Description</small>
                                                    }
                                                </td>
                                                <td class="text-end text-success fw-bold">@item.Price.ToString("N0") đ</td>
                                                <td class="text-center">
                                                    <span class="badge @(item.StockQuantity <= item.LowStockThreshold ? "bg-warning text-dark" : "bg-light text-dark border")">
                                                        @item.StockQuantity
                                                    </span>
                                                </td>
                                                <td>
                                                    <input type="number"
                                                           name="concessions[@i].Quantity"
                                                           class="form-control form-control-sm text-center concession-qty-input"
                                                           data-price="@item.Price"
                                                           data-name="@item.Name"
                                                           data-index="@i"
                                                           data-max="@item.StockQuantity"
                                                           value="0" min="0" max="@item.StockQuantity" />
                                                </td>
                                                <td class="text-end fw-bold text-dark" id="concession-subtotal-@i">
                                                    0 đ
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Cột phải: Hóa đơn và Xác nhận thanh toán gộp *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-success sticky-top" style="top: 20px;">
                    <div class="card-header bg-success text-white py-3 fw-bold">
                        <i class="bi bi-cash-coin me-1"></i> Thông tin thanh toán tại quầy
                    </div>
                    <div class="card-body">
                        @* Danh sách ghế đã chọn *@
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label text-muted small mb-0">Ghế đã chọn:</label>
                                <button type="button" id="clearAllSeatsBtn" class="btn btn-link btn-sm p-0 text-decoration-none text-danger small" style="display: none;">
                                    <i class="bi bi-x-circle"></i> Bỏ chọn tất cả
                                </button>
                            </div>
                            <div id="selectedSeatsContainer" class="p-2 border rounded bg-light" style="min-height: 60px;">
                                <span class="text-muted small fst-italic" id="emptySeatNotice">Chưa chọn ghế nào</span>
                                <div id="selectedBadges" class="d-flex flex-wrap gap-1"></div>
                            </div>
                        </div>

                        @* Bảng tính tiền chi tiết *@
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td class="text-muted">Số lượng vé:</td>
                                    <td class="text-end fw-bold" id="totalQtyDisplay">0 vé</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Tiền vé xem phim:</td>
                                    <td class="text-end fw-bold text-primary" id="ticketTotalDisplay">0 đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Tiền bắp nước kèm:</td>
                                    <td class="text-end fw-bold text-info" id="concessionTotalDisplay">0 đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phương thức thanh toán:</td>
                                    <td class="text-end">
                                        <select name="paymentMethod" id="paymentMethodSelect" class="form-select form-select-sm d-inline-block w-auto">
                                            <option value="Cash" selected>Tiền mặt (Cash)</option>
                                            <option value="VNPay_Simulated">VNPay (Giả lập QR)</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr class="border-top">
                                    <td class="fs-5 fw-bold text-dark pt-2">Tổng thanh toán:</td>
                                    <td class="fs-4 fw-bold text-danger text-end pt-2" id="grandTotalDisplay">0 đ</td>
                                </tr>
                            </table>
                        </div>

                        <div class="alert alert-info py-2 small mb-3">
                            <i class="bi bi-info-circle-fill"></i> Hệ thống tự động xuất riêng 2 hóa đơn (vé và bắp nước) để phục vụ đối soát và quản lý kho.
                        </div>

                        <div id="cashConfirmSection" class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="confirmCashCheck" />
                            <label class="form-check-label small fw-semibold" for="confirmCashCheck">
                                Xác nhận đã thu đủ tiền mặt từ khách hàng
                            </label>
                        </div>

                        <button type="button" id="submitSellBtn" class="btn btn-success w-100 py-2 fw-bold fs-6" disabled>
                            <i class="bi bi-check-circle-fill me-1"></i> <span id="submitBtnText">Xác nhận & Bán vé (Tiền mặt)</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@* MODAL THANH TOÁN VNPAY GIẢ LẬP CÓ MÃ QR *@
<div class="modal fade" id="vnPaySimulatedModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="vnPayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="vnPayModalLabel">
                    <i class="bi bi-qr-code-scan me-2"></i> Thanh toán VNPay Giả Lập tại quầy
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="modalCloseX"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="alert alert-warning py-2 small mb-3 text-start">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>Mô phỏng Demo:</strong> Đây là luồng thanh toán VNPay GIẢ LẬP tại quầy vé. Khách dùng điện thoại quét mã QR mô phỏng, không thu tiền thật.
                </div>

                <div class="mb-3">
                    <div class="text-muted small">Số tiền khách cần thanh toán:</div>
                    <div class="fs-2 fw-bold text-danger my-1" id="qrModalTotal">0 đ</div>
                    <div class="small text-muted">Mã giữ chỗ: <span class="badge bg-secondary font-monospace" id="qrModalBookingCode">-</span></div>
                </div>

                @* Khung mã QR giả lập *@
                <div class="p-3 bg-white border rounded shadow-sm d-inline-block mb-3">
                    <img id="qrModalImage" src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=VNPAY_SIMULATED_DEMO" alt="Mã QR VNPay giả lập" style="width: 180px; height: 180px;" class="img-fluid" />
                    <div class="small text-muted mt-2 fw-semibold">Quét mã QR bằng App VNPay / Ngân hàng (Mô phỏng)</div>
                </div>

                @* Chi tiết giao dịch tóm tắt *@
                <div class="text-start bg-light p-3 rounded small mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Phim:</span>
                        <strong class="text-end">@(screening?.Movie?.Title ?? "")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Suất chiếu:</span>
                        <span>@(screening != null ? screening.StartAt.ToLocalTime().ToString("HH:mm - dd/MM/yyyy") : "")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Phòng & Ghế:</span>
                        <span class="text-end fw-bold text-primary" id="qrModalSeats">-</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Thời gian giữ ghế còn lại:</span>
                        <span class="badge bg-warning text-dark" id="qrModalCountdown"><i class="bi bi-clock me-1"></i> --:--</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" id="confirmVnPaySuccessBtn" class="btn btn-success py-2 fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Khách đã thanh toán thành công (Mô phỏng)
                    </button>
                    <button type="button" id="cancelVnPayBtn" class="btn btn-outline-danger py-2">
                        <i class="bi bi-x-circle me-1"></i> Khách hủy / Thanh toán thất bại
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Bổ sung hiệu ứng hover và định dạng tương tác màn hình quầy */
    .seat-button.available:hover {
        background-color: #e6f7ec;
        border-color: #2e7d32;
        cursor: pointer;
        transform: translateY(-2px);
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
    }
    .seat-button.mine:hover {
        cursor: pointer;
        transform: translateY(-2px);
        box-shadow: 0 2px 5px rgba(20, 89, 191, 0.3);
    }
    .seat-map-scroll {
        background: #fafbfc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px 10px;
    }
</style>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const emptyNotice = document.getElementById('emptySeatNotice');
            const badgesContainer = document.getElementById('selectedBadges');
            const clearAllSeatsBtn = document.getElementById('clearAllSeatsBtn');
            const totalQtyDisplay = document.getElementById('totalQtyDisplay');
            const ticketTotalDisplay = document.getElementById('ticketTotalDisplay');
            const concessionTotalDisplay = document.getElementById('concessionTotalDisplay');
            const grandTotalDisplay = document.getElementById('grandTotalDisplay');
            const submitBtn = document.getElementById('submitSellBtn');
            const submitBtnText = document.getElementById('submitBtnText');
            const confirmCheck = document.getElementById('confirmCashCheck');
            const cashConfirmSection = document.getElementById('cashConfirmSection');
            const paymentMethodSelect = document.getElementById('paymentMethodSelect');
            const sellForm = document.getElementById('sellForm');
            const concessionInputs = document.querySelectorAll('.concession-qty-input');
            const countdownContainer = document.getElementById('countdownContainer');
            const countdownTimer = document.getElementById('countdownTimer');
            const holdingBookingIdInput = document.getElementById('holdingBookingIdInput');
            const hiddenSeatInputs = document.getElementById('hiddenSeatInputs');
            const seatMap = document.getElementById('seat-map');

            // Elements của modal VNPay giả lập
            const qrModalTotal = document.getElementById('qrModalTotal');
            const qrModalSeats = document.getElementById('qrModalSeats');
            const qrModalBookingCode = document.getElementById('qrModalBookingCode');
            const qrModalCountdown = document.getElementById('qrModalCountdown');
            const qrModalImage = document.getElementById('qrModalImage');
            const confirmVnPaySuccessBtn = document.getElementById('confirmVnPaySuccessBtn');
            const cancelVnPayBtn = document.getElementById('cancelVnPayBtn');
            const vnPayModalEl = document.getElementById('vnPaySimulatedModal');
            let vnPayModalInstance = null;
            if (vnPayModalEl && typeof bootstrap !== 'undefined') {
                vnPayModalInstance = new bootstrap.Modal(vnPayModalEl);
            }

            const screeningId = @(screening?.ScreeningId ?? 0);
            const hubUrl = '@(ViewBag.HubUrl ?? "/hubs/seats")';
            const statusBadge = document.getElementById('signalrStatusBadge');

            let currentBookingId = @(holdingBookingId != null ? holdingBookingId.Value.ToString() : "null");
            let expiresAt = @(holdingExpiresAt != null ? $"new Date('{(DateTime)holdingExpiresAt.Value:O}')" : "null");
            let isHolding = false;

            function getCsrfToken() {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            function isPaymentCash() {
                return !paymentMethodSelect || paymentMethodSelect.value === 'Cash';
            }

            // Trích xuất danh sách ghế đang được quầy chọn
            function getSelectedSeats() {
                const selected = [];
                document.querySelectorAll('.seat-button.mine').forEach(btn => {
                    selected.push({
                        id: parseInt(btn.dataset.seatId),
                        price: parseFloat(btn.dataset.price) || 0,
                        code: btn.dataset.code,
                        row: btn.dataset.row,
                        num: parseInt(btn.dataset.num) || 0,
                        type: btn.dataset.type,
                        typeDisplay: btn.dataset.typeDisplay || btn.dataset.type
                    });
                });

                // Sắp xếp theo hàng và số ghế
                selected.sort((a, b) => {
                    if (a.row === b.row) return a.num - b.num;
                    return a.row.localeCompare(b.row);
                });

                return selected;
            }

            // Đồng bộ thẻ input hidden seatIds trong form
            function syncHiddenInputs(selectedSeats) {
                if (!hiddenSeatInputs) return;
                hiddenSeatInputs.innerHTML = '';
                selectedSeats.forEach(s => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'seatIds';
                    input.value = s.id;
                    input.id = 'hidden-seat-' + s.id;
                    hiddenSeatInputs.appendChild(input);
                });
            }

            // Tính toán tổng số lượng, tổng tiền và trạng thái nút thanh toán
            function updateAllTotals() {
                const selected = getSelectedSeats();
                let ticketTotal = 0;
                badgesContainer.innerHTML = '';

                selected.forEach(s => {
                    ticketTotal += s.price;
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-primary px-2 py-1 fs-6 d-inline-flex align-items-center gap-1';
                    badge.innerHTML = `<span>${s.code}</span> <small class="text-white-50">(${s.typeDisplay})</small>`;
                    badge.title = `${s.code} · ${s.typeDisplay} · ${s.price.toLocaleString('vi-VN')} đ`;
                    badgesContainer.appendChild(badge);
                });

                if (selected.length > 0) {
                    emptyNotice.style.display = 'none';
                    if (clearAllSeatsBtn) clearAllSeatsBtn.style.display = 'inline';
                } else {
                    emptyNotice.style.display = 'inline';
                    if (clearAllSeatsBtn) clearAllSeatsBtn.style.display = 'none';
                }

                totalQtyDisplay.textContent = selected.length + ' vé';
                ticketTotalDisplay.textContent = ticketTotal.toLocaleString('vi-VN') + ' đ';

                // 2. Tính tiền bắp nước
                let concessionTotal = 0;
                concessionInputs.forEach(input => {
                    const qty = parseInt(input.value) || 0;
                    const price = parseFloat(input.getAttribute('data-price')) || 0;
                    const idx = input.getAttribute('data-index');
                    const subtotal = qty * price;
                    concessionTotal += subtotal;

                    const subtotalCell = document.getElementById('concession-subtotal-' + idx);
                    if (subtotalCell) {
                        subtotalCell.textContent = subtotal.toLocaleString('vi-VN') + ' đ';
                    }
                });

                concessionTotalDisplay.textContent = concessionTotal.toLocaleString('vi-VN') + ' đ';

                // 3. Tổng thanh toán
                const grandTotal = ticketTotal + concessionTotal;
                grandTotalDisplay.textContent = grandTotal.toLocaleString('vi-VN') + ' đ';

                // 4. Đồng bộ hidden inputs
                syncHiddenInputs(selected);

                // 5. Kiểm tra nút submit theo phương thức thanh toán
                if (isPaymentCash()) {
                    if (cashConfirmSection) cashConfirmSection.style.display = 'block';
                    if (submitBtnText) submitBtnText.textContent = 'Xác nhận & Bán vé (Tiền mặt)';
                    submitBtn.className = 'btn btn-success w-100 py-2 fw-bold fs-6';
                    submitBtn.disabled = !(selected.length > 0 && confirmCheck.checked && !isHolding);
                } else {
                    if (cashConfirmSection) cashConfirmSection.style.display = 'none';
                    if (submitBtnText) submitBtnText.textContent = 'Mở mã QR VNPay (Giả lập)';
                    submitBtn.className = 'btn btn-primary w-100 py-2 fw-bold fs-6';
                    submitBtn.disabled = !(selected.length > 0 && !isHolding);
                }
            }

            // -------------------------------------------------------------
            // CƠ CHẾ GIỮ GHẾ 5 PHÚT TẠI SERVER (TÁI SỬ DỤNG LOGIC BÁCH)
            // -------------------------------------------------------------
            async function holdSeatsOnServer(seatIds) {
                if (isHolding) return false;
                isHolding = true;
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/CounterTicket/HoldSeats', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getCsrfToken()
                        },
                        body: JSON.stringify({
                            screeningId: screeningId,
                            bookingId: currentBookingId,
                            screeningSeatIds: seatIds
                        })
                    });

                    if (!response.ok) {
                        let errMsg = 'Không thể giữ ghế trên server.';
                        try {
                            const errData = await response.json();
                            if (errData && errData.message) errMsg = errData.message;
                        } catch { }
                        throw new Error(errMsg);
                    }

                    const data = await response.json();
                    if (data && data.bookingId) {
                        currentBookingId = data.bookingId;
                        holdingBookingIdInput.value = data.bookingId;
                    } else if (seatIds.length === 0) {
                        currentBookingId = null;
                        holdingBookingIdInput.value = '';
                    }

                    if (data && data.expiresAt) {
                        expiresAt = new Date(data.expiresAt);
                        countdownContainer.style.display = 'inline-flex';
                    } else {
                        expiresAt = null;
                        countdownContainer.style.display = 'none';
                    }

                    return true;
                } catch (err) {
                    alert('LỖI GIỮ GHẾ: ' + err.message);
                    await refreshSeatSnapshot();
                    return false;
                } finally {
                    isHolding = false;
                    updateAllTotals();
                }
            }

            // Xử lý sự kiện click chọn / bỏ chọn ghế
            async function handleSeatButtonClick(btn) {
                if (isHolding || btn.disabled) return;

                const seatId = parseInt(btn.dataset.seatId);
                const wasMine = btn.classList.contains('mine');
                const selected = getSelectedSeats();
                const currentlySelectedIds = selected.map(s => s.id);

                let targetIds;
                if (wasMine) {
                    // Bỏ chọn ghế
                    targetIds = currentlySelectedIds.filter(id => id !== seatId);
                    btn.classList.remove('mine');
                    btn.classList.add('available');
                    btn.setAttribute('aria-pressed', 'false');
                    btn.title = `Ghế ${btn.dataset.code} · ${btn.dataset.typeDisplay} · ${parseFloat(btn.dataset.price).toLocaleString('vi-VN')} đ · Trống`;
                } else {
                    // Chọn thêm ghế
                    if (currentlySelectedIds.length >= 20) {
                        alert('Mỗi lần giao dịch tối đa chọn 20 ghế.');
                        return;
                    }
                    targetIds = [...currentlySelectedIds, seatId];
                    btn.classList.remove('available');
                    btn.classList.add('mine');
                    btn.setAttribute('aria-pressed', 'true');
                    btn.title = `Ghế ${btn.dataset.code} · ${btn.dataset.typeDisplay} · ${parseFloat(btn.dataset.price).toLocaleString('vi-VN')} đ · Quầy đang chọn`;
                }

                // Cập nhật UI tạm thời (optimistic)
                updateAllTotals();

                // Gửi request giữ ghế tới server; nếu thất bại thì rollback
                const success = await holdSeatsOnServer(targetIds);
                if (!success) {
                    if (wasMine) {
                        btn.classList.remove('available');
                        btn.classList.add('mine');
                        btn.setAttribute('aria-pressed', 'true');
                        btn.title = `Ghế ${btn.dataset.code} · ${btn.dataset.typeDisplay} · ${parseFloat(btn.dataset.price).toLocaleString('vi-VN')} đ · Quầy đang chọn`;
                    } else {
                        btn.classList.remove('mine');
                        btn.classList.add('available');
                        btn.setAttribute('aria-pressed', 'false');
                        btn.title = `Ghế ${btn.dataset.code} · ${btn.dataset.typeDisplay} · ${parseFloat(btn.dataset.price).toLocaleString('vi-VN')} đ · Trống`;
                    }
                    updateAllTotals();
                }
            }

            // Gán event delegation trên toàn bộ ma trận ghế
            if (seatMap) {
                seatMap.addEventListener('click', function (e) {
                    const btn = e.target.closest('.seat-button');
                    if (btn && !btn.disabled) {
                        handleSeatButtonClick(btn);
                    }
                });
            }

            // Nút bỏ chọn tất cả
            if (clearAllSeatsBtn) {
                clearAllSeatsBtn.addEventListener('click', async function () {
                    if (isHolding) return;
                    const selected = getSelectedSeats();
                    if (selected.length === 0) return;

                    const success = await holdSeatsOnServer([]);
                    if (success) {
                        document.querySelectorAll('.seat-button.mine').forEach(btn => {
                            btn.classList.remove('mine');
                            btn.classList.add('available');
                            btn.setAttribute('aria-pressed', 'false');
                            btn.title = `Ghế ${btn.dataset.code} · ${btn.dataset.typeDisplay} · ${parseFloat(btn.dataset.price).toLocaleString('vi-VN')} đ · Trống`;
                        });
                        updateAllTotals();
                    }
                });
            }

            updateAllTotals();

            // Đồng hồ đếm ngược 5 phút
            window.setInterval(function () {
                if (expiresAt && currentBookingId) {
                    const now = new Date();
                    const diffSec = Math.max(0, Math.floor((expiresAt - now) / 1000));
                    const mins = String(Math.floor(diffSec / 60)).padStart(2, '0');
                    const secs = String(diffSec % 60).padStart(2, '0');
                    countdownTimer.textContent = mins + ':' + secs;
                    if (qrModalCountdown) {
                        qrModalCountdown.innerHTML = '<i class="bi bi-clock me-1"></i> ' + mins + ':' + secs;
                    }

                    if (diffSec === 0) {
                        if (vnPayModalInstance) {
                            vnPayModalInstance.hide();
                        }
                        const expiredBookingId = currentBookingId;
                        expiresAt = null;
                        currentBookingId = null;
                        holdingBookingIdInput.value = '';
                        countdownContainer.style.display = 'none';
                        alert('Đã hết thời gian 5 phút giữ ghế tại quầy. Ghế đã được tự động giải phóng.');

                        document.querySelectorAll('.seat-button.mine').forEach(btn => {
                            btn.className = 'seat-button available' + (btn.dataset.type === 'Couple' ? ' couple' : '');
                            btn.setAttribute('aria-pressed', 'false');
                            btn.title = `Ghế ${btn.dataset.code} · ${btn.dataset.typeDisplay} · ${parseFloat(btn.dataset.price).toLocaleString('vi-VN')} đ · Trống`;
                        });
                        updateAllTotals();

                        if (expiredBookingId) {
                            fetch('/CounterTicket/ReleaseSeats', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': getCsrfToken()
                                },
                                body: JSON.stringify({
                                    screeningId: screeningId,
                                    bookingId: expiredBookingId,
                                    screeningSeatIds: []
                                })
                            }).finally(() => {
                                refreshSeatSnapshot();
                            });
                        }
                    }
                }
            }, 1000);

            concessionInputs.forEach(input => {
                input.addEventListener('input', function () {
                    const max = parseInt(this.getAttribute('data-max')) || 0;
                    let val = parseInt(this.value) || 0;
                    if (val < 0) this.value = 0;
                    if (val > max) this.value = max;
                    updateAllTotals();
                });
            });

            if (confirmCheck) {
                confirmCheck.addEventListener('change', updateAllTotals);
            }

            if (paymentMethodSelect) {
                paymentMethodSelect.addEventListener('change', updateAllTotals);
            }

            // Xử lý nút bấm thanh toán (phân luồng Tiền mặt vs VNPay Giả lập)
            submitBtn.addEventListener('click', function (e) {
                if (submitBtn.disabled) return;

                if (isPaymentCash()) {
                    if (!confirmCheck.checked) {
                        alert('Vui lòng xác nhận đã thu đủ tiền mặt từ khách hàng.');
                        return;
                    }
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý giao dịch tiền mặt...';
                    sellForm.submit();
                } else {
                    const selected = getSelectedSeats();
                    if (selected.length === 0) {
                        alert('Vui lòng chọn ít nhất một ghế.');
                        return;
                    }

                    // Cập nhật thông tin vào modal QR
                    qrModalTotal.textContent = grandTotalDisplay.textContent;
                    qrModalSeats.textContent = selected.map(s => s.code).join(', ');
                    qrModalBookingCode.textContent = currentBookingId ? ('CT-HOLD-' + currentBookingId) : 'Đang giữ chỗ';

                    // Cập nhật ảnh QR giả lập
                    const cleanAmount = grandTotalDisplay.textContent.replace(/[^0-9]/g, '');
                    const qrData = 'VNPAY_SIMULATED:SCREENING_' + screeningId + ':BOOKING_' + (currentBookingId || 'TEMP') + ':AMOUNT_' + cleanAmount;
                    qrModalImage.src = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + encodeURIComponent(qrData);

                    if (vnPayModalInstance) {
                        vnPayModalInstance.show();
                    } else if (typeof bootstrap !== 'undefined' && vnPayModalEl) {
                        vnPayModalInstance = new bootstrap.Modal(vnPayModalEl);
                        vnPayModalInstance.show();
                    }
                }
            });

            if (confirmVnPaySuccessBtn) {
                confirmVnPaySuccessBtn.addEventListener('click', function () {
                    confirmVnPaySuccessBtn.disabled = true;
                    if (cancelVnPayBtn) cancelVnPayBtn.disabled = true;
                    confirmVnPaySuccessBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xác nhận VNPay & in hóa đơn...';
                    sellForm.submit();
                });
            }

            if (cancelVnPayBtn) {
                cancelVnPayBtn.addEventListener('click', function () {
                    if (vnPayModalInstance) {
                        vnPayModalInstance.hide();
                    }
                    alert('Giao dịch VNPay giả lập đã bị hủy. Ghế vẫn đang được giữ trong thời hạn (5 phút). Bạn có thể đổi sang thanh toán Tiền mặt hoặc chọn lại ghế.');
                });
            }

            // -------------------------------------------------------------
            // TÍCH HỢP SIGNALR: ĐỒNG BỘ TRẠNG THÁI GHẾ REALTIME VỚI BÁCH
            // -------------------------------------------------------------
            async function refreshSeatSnapshot() {
                if (isHolding) return;

                try {
                    const url = '/CounterTicket/SeatSnapshot?screeningId=' + screeningId +
                                (currentBookingId ? '&bookingId=' + currentBookingId : '');
                    const response = await fetch(url);
                    if (!response.ok) return;
                    const data = await response.json();
                    if (!data || !data.seats) return;

                    let lostSeats = [];

                    data.seats.forEach(seat => {
                        const btn = document.getElementById('seat-btn-' + seat.screeningSeatId);
                        if (!btn) return;

                        const isCouple = seat.seatType === 'Couple';
                        const coupleClass = isCouple ? ' couple' : '';
                        const typeDisplay = isCouple ? 'Đôi' : (seat.seatType === 'Standard' ? 'Thường' : seat.seatType);
                        const isHeldByMe = (seat.isMine === true);
                        const priceText = (seat.price || 0).toLocaleString('vi-VN') + ' đ';

                        if (isHeldByMe) {
                            // Ghế do chính quầy này đang giữ
                            btn.className = 'seat-button mine' + coupleClass;
                            btn.disabled = false;
                            btn.setAttribute('aria-pressed', 'true');
                            btn.title = `Ghế ${seat.rowLabel}${seat.seatNumber} · ${typeDisplay} · ${priceText} · Quầy đang chọn`;
                        } else if (seat.status === 'Available') {
                            // Ghế trống
                            btn.className = 'seat-button available' + coupleClass;
                            btn.disabled = false;
                            btn.setAttribute('aria-pressed', 'false');
                            btn.title = `Ghế ${seat.rowLabel}${seat.seatNumber} · ${typeDisplay} · ${priceText} · Trống`;
                        } else if (seat.status === 'Held') {
                            // Ghế người khác giữ
                            if (btn.classList.contains('mine')) {
                                lostSeats.push(seat.rowLabel + seat.seatNumber);
                            }
                            btn.className = 'seat-button held' + coupleClass;
                            btn.disabled = true;
                            btn.setAttribute('aria-pressed', 'false');
                            btn.title = `Ghế ${seat.rowLabel}${seat.seatNumber} · ${typeDisplay} · ${priceText} · Người khác giữ`;
                        } else if (seat.status === 'Sold') {
                            // Ghế đã bán
                            if (btn.classList.contains('mine')) {
                                lostSeats.push(seat.rowLabel + seat.seatNumber);
                            }
                            btn.className = 'seat-button sold' + coupleClass;
                            btn.disabled = true;
                            btn.setAttribute('aria-pressed', 'false');
                            btn.title = `Ghế ${seat.rowLabel}${seat.seatNumber} · ${typeDisplay} · ${priceText} · Đã bán`;
                        } else {
                            // Khóa bảo trì / Blocked
                            if (btn.classList.contains('mine')) {
                                lostSeats.push(seat.rowLabel + seat.seatNumber);
                            }
                            btn.className = 'seat-button blocked' + coupleClass;
                            btn.disabled = true;
                            btn.setAttribute('aria-pressed', 'false');
                            btn.title = `Ghế ${seat.rowLabel}${seat.seatNumber} · ${typeDisplay} · ${priceText} · Không sử dụng`;
                        }
                    });

                    updateAllTotals();

                    if (lostSeats.length > 0) {
                        alert('Chú ý: Ghế ' + lostSeats.join(', ') + ' vừa được khách hàng khác giữ hoặc mua online!');
                    }
                } catch (e) {
                    console.warn("Lỗi cập nhật sơ đồ ghế realtime:", e);
                }
            }

            if (window.signalR && screeningId > 0) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl(hubUrl)
                    .withAutomaticReconnect()
                    .build();

                connection.on("SeatStatusChanged", function (data) {
                    if (!data || data.screeningId === screeningId) {
                        refreshSeatSnapshot();
                    }
                });

                connection.onreconnecting(() => {
                    if (statusBadge) {
                        statusBadge.className = "badge bg-warning text-dark border";
                        statusBadge.innerHTML = '<i class="bi bi-arrow-repeat"></i> Đang kết nối lại...';
                    }
                });

                connection.onreconnected(async () => {
                    if (statusBadge) {
                        statusBadge.className = "badge bg-success text-white border";
                        statusBadge.innerHTML = '<i class="bi bi-broadcast"></i> Cập nhật trực tiếp';
                    }
                    try {
                        await connection.invoke("JoinScreening", screeningId);
                        refreshSeatSnapshot();
                    } catch (e) {
                        console.warn(e);
                    }
                });

                connection.start().then(async () => {
                    await connection.invoke("JoinScreening", screeningId);
                    if (statusBadge) {
                        statusBadge.className = "badge bg-success text-white border";
                        statusBadge.innerHTML = '<i class="bi bi-broadcast"></i> Cập nhật trực tiếp';
                    }
                }).catch(err => {
                    console.warn("SignalR connection failed:", err);
                    if (statusBadge) {
                        statusBadge.className = "badge bg-secondary text-white border";
                        statusBadge.innerHTML = '<i class="bi bi-clock"></i> Cập nhật định kỳ';
                    }
                });
            }
        });
    </script>
}
