@model IEnumerable<PRN222_CinemaManagement.Models.Entities.Auditorium>

@{
    ViewData["Title"] = "Quản lý phòng chiếu";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý phòng chiếu</h3>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Thêm phòng chiếu mới</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">Mã</th>
                    <th>Tên phòng</th>
                    <th>Kích thước</th>
                    <th>Tổng số ghế</th>
                    <th>Trạng thái</th>
                    <th style="width: 260px;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">Chưa có phòng chiếu nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.AuditoriumId</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.TotalRows hàng × @item.TotalColumns cột</td>
                            <td>@item.Seats.Count ghế</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else if (item.Status == "Maintenance")
                                {
                                    <span class="badge bg-warning text-dark">Bảo trì</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ngừng dùng</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="ConfigureSeats" asp-route-id="@item.AuditoriumId" class="btn btn-sm btn-outline-primary me-1">
                                    Sơ đồ ghế
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.AuditoriumId" class="btn btn-sm btn-outline-secondary me-1">
                                    Sửa
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.AuditoriumId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Bạn có chắc muốn đổi trạng thái phòng này?');">
                                        @(item.Status == "Active" ? "Bảo trì" : "Kích hoạt")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
