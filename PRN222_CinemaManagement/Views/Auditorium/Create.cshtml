@model PRN222_CinemaManagement.Models.ViewModels.AuditoriumCreateViewModel

@{
    ViewData["Title"] = "Thêm phòng chiếu";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Thêm phòng chiếu mới (UC-25)</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Phòng chiếu 2" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TotalRows" class="form-label fw-bold"></label>
                            <input asp-for="TotalRows" class="form-control" type="number" min="1" max="26" />
                            <small class="text-muted">Từ 1 đến 26 hàng (A - Z)</small>
                            <span asp-validation-for="TotalRows" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TotalColumns" class="form-label fw-bold"></label>
                            <input asp-for="TotalColumns" class="form-control" type="number" min="1" max="20" />
                            <small class="text-muted">Số ghế mỗi hàng</small>
                            <span asp-validation-for="TotalColumns" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Hoạt động (Active)</option>
                            <option value="Maintenance">Bảo trì (Maintenance)</option>
                        </select>
                    </div>

                    <div class="alert alert-secondary py-2 small">
                        Hệ thống sẽ tự động tạo ma trận ghế ban đầu. Sau khi tạo xong, bạn có thể chỉnh loại ghế (VIP, Couple) trực tiếp trên sơ đồ.
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary">Tạo phòng chiếu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
