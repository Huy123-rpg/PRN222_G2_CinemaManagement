@model PRN222_CinemaManagement.Models.Entities.Booking

@{
    ViewData["Title"] = "Vé điện tử & Mã QR - " + Model.BookingCode;
    string? role = Context.Session.GetString("Role");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Vé điện tử & Mã QR</h4>
        <small class="text-muted">Mã đơn đặt vé: <strong>@Model.BookingCode</strong></small>
    </div>
    <div>
        @if (role == "Customer")
        {
            <a asp-action="MyBookings" class="btn btn-outline-secondary btn-sm">&larr; Lịch sử vé</a>
        }
        else
        {
            <a asp-action="StaffLookup" class="btn btn-outline-secondary btn-sm">&larr; Quay lại tra cứu</a>
        }
        <button class="btn btn-primary btn-sm ms-2" onclick="window.print()">In vé</button>
    </div>
</div>

<!-- Thông tin chung về suất chiếu -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <small class="text-muted">Phim:</small>
                <h5 class="fw-bold text-primary mb-0">@Model.Showtime.Movie.Title</h5>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Suất chiếu:</small>
                <div class="fw-bold">@Model.Showtime.StartAt.ToString("HH:mm - dd/MM/yyyy")</div>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Phòng chiếu:</small>
                <div class="fw-bold">@Model.Showtime.Auditorium.Name</div>
            </div>
            <div class="col-md-2 text-md-end">
                <small class="text-muted">Trạng thái đơn:</small>
                <div>
                    @if (Model.Status == "Confirmed")
                    {
                        <span class="badge bg-success">Đã thanh toán</span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-secondary">Đã hủy</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách từng vé điện tử có mã QR -->
<div class="row g-3">
    @foreach (var ticket in Model.Tickets)
    {
        <div class="col-md-6">
            <div class="card shadow-sm border h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <!-- Thông tin vé bên trái -->
                        <div>
                            <div class="small text-muted">MÃ VÉ ĐIỆN TỬ:</div>
                            <h6 class="fw-bold text-dark mb-2">@ticket.TicketCode</h6>

                            <div class="mb-1">
                                Ghế: <strong class="fs-5 text-danger">@ticket.ShowtimeSeat.Seat.RowLabel@ticket.ShowtimeSeat.Seat.SeatNumber</strong>
                                <span class="badge bg-secondary ms-1">@ticket.ShowtimeSeat.Seat.SeatType.TypeName</span>
                            </div>

                            <div class="small text-muted mb-2">
                                Giá vé: <strong>@ticket.Price.ToString("N0") VNĐ</strong>
                            </div>

                            <div>
                                @if (ticket.Status == "Valid")
                                {
                                    <span class="badge bg-success">Hợp lệ (Chưa vào rạp)</span>
                                }
                                else if (ticket.Status == "CheckedIn")
                                {
                                    <span class="badge bg-info text-dark">Đã soát vé: @ticket.CheckedInAt?.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã hủy</span>
                                }
                            </div>
                        </div>

                        <!-- Ảnh mã QR bên phải -->
                        <div class="text-center ms-3">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&data=@ticket.TicketCode"
                                 alt="Mã QR: @ticket.TicketCode"
                                 class="border rounded p-1"
                                 style="width: 120px; height: 120px;" />
                            <div class="small text-muted mt-1" style="font-size: 0.7rem;">Mã QR soát vé</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-secondary py-2 mt-4 small text-center">
    Quý khách vui lòng xuất trình mã QR trên màn hình điện thoại hoặc vé in tại cửa phòng chiếu để nhân viên rạp soát vé (Check-in).
</div>
