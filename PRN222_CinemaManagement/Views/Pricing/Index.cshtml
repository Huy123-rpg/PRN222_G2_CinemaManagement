@model PRN222_CinemaManagement.Models.ViewModels.PricingIndexViewModel

@{
    ViewData["Title"] = "Thiết lập quy tắc giá vé (UC-27)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cấu hình loại ghế & Quy tắc giá vé</h2>
        <p class="text-muted mb-0">Quản lý hệ số nhân giá theo loại ghế và tính toán giá vé tự động (UC-27)</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Cột 1: Danh sách các loại ghế & hệ số giá -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Danh sách loại ghế & Hệ số giá</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Loại ghế</th>
                                <th>Mô tả</th>
                                <th>Hệ số giá</th>
                                <th>Số ghế hiện tại</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var st in Model.SeatTypes)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">
                                        @if (st.TypeName == "VIP")
                                        {
                                            <span class="badge bg-warning text-dark me-1">VIP</span>
                                        }
                                        else if (st.TypeName == "Couple")
                                        {
                                            <span class="badge bg-danger me-1">Couple</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary me-1">Standard</span>
                                        }
                                        @st.TypeName
                                    </td>
                                    <td class="text-muted small">@st.Description</td>
                                    <td>
                                        <span class="badge bg-info text-dark fs-6">
                                            @st.PriceMultiplier.ToString("0.00") x
                                        </span>
                                    </td>
                                    <td>
                                        <strong>@st.TotalSeatsInSystem</strong> ghế
                                    </td>
                                    <td>
                                        @if (st.IsActive)
                                        {
                                            <span class="badge bg-success">Đang dùng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tạm tắt</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="EditSeatType" asp-route-id="@st.SeatTypeId" class="btn btn-sm btn-outline-primary">
                                            Sửa hệ số
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột 2: Bảng mô phỏng tính giá vé tự động (Simulated Pricing Matrix) -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold">Mô phỏng tính giá vé tự động</h5>
                <small class="text-muted">Kiểm tra công thức: Giá vé = Giá cơ sở suất chiếu × Hệ số loại ghế</small>
            </div>
            <div class="card-body p-4">
                <form method="get" asp-action="Index" class="mb-4">
                    <label class="form-label fw-semibold">Nhập giá vé cơ sở thử nghiệm (BasePrice):</label>
                    <div class="input-group">
                        <input type="number" name="samplePrice" class="form-control" value="@Model.SampleBasePrice" step="5000" min="10000" />
                        <span class="input-group-text">VNĐ</span>
                        <button type="submit" class="btn btn-primary">Tính thử</button>
                    </div>
                </form>

                <h6 class="fw-bold mb-3 text-secondary">Bảng giá vé dự kiến tính theo công thức:</h6>
                <div class="list-group">
                    @foreach (var st in Model.SeatTypes.Where(s => s.IsActive))
                    {
                        var calculatedPrice = Model.SampleBasePrice * st.PriceMultiplier;
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <h6 class="mb-0 fw-bold">@st.TypeName</h6>
                                <small class="text-muted">Hệ số: @st.PriceMultiplier.ToString("0.00") x @Model.SampleBasePrice.ToString("N0") đ</small>
                            </div>
                            <span class="fs-5 fw-bold text-success">
                                @calculatedPrice.ToString("N0") VNĐ
                            </span>
                        </div>
                    }
                </div>

                <div class="alert alert-light border mt-4 small text-muted mb-0">
                    ℹ️ <strong>Quy tắc nghiệp vụ:</strong> Khi tạo suất chiếu (Showtime), Manager chỉ cần nhập một mức giá cơ sở (`BasePrice`). Hệ thống sẽ tự động nhân với hệ số của từng loại ghế để xác định giá bán chính thức cho cả đặt vé online và tại quầy.
                </div>
            </div>
        </div>
    </div>
</div>
