@model MyBookingsViewModel
@{ ViewData["Title"] = "Đơn đặt vé của tôi"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Đơn đặt vé của tôi</h1>
        <p class="text-muted mb-0">Mở lại đơn đang giữ ghế để thanh toán hoặc xem vé của đơn đã xác nhận.</p>
    </div>
    @if (Model.Pagination.TotalItems > 0)
    {
        <span class="small text-muted">
            Hiển thị <strong>@Model.Pagination.StartItem–@Model.Pagination.EndItem</strong> / <strong>@Model.Pagination.TotalItems</strong> đơn
        </span>
    }
</div>
@if (Model.Bookings.Count == 0)
{
    <div class="alert alert-info">Bạn chưa có đơn đặt vé. <a asp-controller="Movies" asp-action="Index">Chọn phim ngay</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Mã đơn / Phim</th><th scope="col">Suất chiếu</th><th scope="col">Tổng tiền</th><th scope="col">Trạng thái</th><th scope="col">Chi tiết</th></tr></thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td><strong>@booking.MovieTitle</strong><br /><code>@booking.BookingCode</code></td>
                        <td>@BookingDisplay.VietnamTime(booking.StartAt).ToString("HH:mm dd/MM/yyyy")<br /><small>@booking.Auditorium</small></td>
                        <td>@booking.TotalAmount.ToString("N0") đ</td><td>@BookingDisplay.StatusText(booking.Status)</td>
                        <td>
                            <a asp-action="@(booking.Status == "Confirmed" ? "Success" : "Checkout")" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-primary me-1">@(booking.Status == "Confirmed" ? "Xem vé" : "Xem đơn")</a>
                            @if (booking.Status == "Confirmed")
                            {
                                var (isEligible, reason) = CancellationRules.CheckEligibility(booking.Status, booking.StartAt, booking.Tickets.Select(t => t.Status));
                                if (isEligible)
                                {
                                    <form asp-controller="Ticket" asp-action="CancelMyBooking" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn hủy đơn vé này không? Ghế sẽ được hoàn trả lại.');">
                                            Hủy vé
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="@reason">
                                        Không thể hủy
                                    </button>
                                    <small class="text-danger d-block mt-1" style="font-size: 0.65rem;" title="@reason">
                                        (@(reason.Contains("soát") ? "Đã soát vé" : (booking.StartAt < DateTime.UtcNow ? "Đã qua giờ" : "Sát giờ <60p")))
                                    </small>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Pagination.TotalPages > 1)
    {
        var pageNumbers = Model.Pagination.GetPageNumbers();
        <nav aria-label="Phân trang đơn đặt vé" class="mt-3">
            <ul class="pagination justify-content-center flex-wrap mb-0">
                <li class="page-item @(Model.Pagination.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="MyBookings" asp-route-page="@(Model.Pagination.Page - 1)" aria-label="Trang trước">« Trước</a>
                </li>

                @if (pageNumbers[0] > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="MyBookings" asp-route-page="1">1</a></li>
                    @if (pageNumbers[0] > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                @foreach (var p in pageNumbers)
                {
                    <li class="page-item @(p == Model.Pagination.Page ? "active" : "")" aria-current="@(p == Model.Pagination.Page ? "page" : null)">
                        <a class="page-link" asp-action="MyBookings" asp-route-page="@p">@p</a>
                    </li>
                }

                @if (pageNumbers[^1] < Model.Pagination.TotalPages)
                {
                    @if (pageNumbers[^1] < Model.Pagination.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" asp-action="MyBookings" asp-route-page="@Model.Pagination.TotalPages">@Model.Pagination.TotalPages</a></li>
                }

                <li class="page-item @(Model.Pagination.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="MyBookings" asp-route-page="@(Model.Pagination.Page + 1)" aria-label="Trang sau">Sau »</a>
                </li>
            </ul>
        </nav>
    }

    <div class="alert alert-light border mt-3 small text-muted">
        ℹ️ <strong>Quy tắc hủy vé:</strong> Quý khách chỉ có thể hủy vé trước giờ chiếu ít nhất <strong>60 phút</strong> và vé chưa được soát vào rạp.
    </div>
}
