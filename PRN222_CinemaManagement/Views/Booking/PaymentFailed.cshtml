@model PaymentFailedViewModel
@{
    ViewData["Title"] = "Thanh toán thất bại";
    var isUserCancelled = Model.ResponseCode == "24";
    var headline = isUserCancelled
        ? "Giao dịch đã bị hủy"
        : "Thanh toán chưa thành công";
}

<section class="eticket-hero payment-failed-hero mb-4" aria-labelledby="payment-failed-title">
    <div class="row g-4 align-items-center">
        <div class="col-lg-8">
            <div class="eticket-status-pill eticket-status-pill--failed mb-3">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="10" cy="10" r="9" fill="#ef4444" />
                    <path d="M7 7l6 6M13 7l-6 6" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
                </svg>
                <span>@(isUserCancelled ? "Đã hủy tại cổng thanh toán" : "Giao dịch không hoàn tất")</span>
            </div>

            <h1 id="payment-failed-title" class="h2 fw-bold text-white mb-2">@headline</h1>
            <p class="eticket-hero-sub mb-3">@Model.FailureMessage</p>

            <div class="d-flex flex-wrap gap-2">
                @if (Model.Booking != null)
                {
                    <span class="eticket-meta-chip">Mã đơn: <strong>@Model.Booking.BookingCode</strong></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ResponseCode))
                {
                    <span class="eticket-meta-chip">Mã VNPay: <strong>@Model.ResponseCode</strong></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TransactionNo))
                {
                    <span class="eticket-meta-chip">Mã GD: <strong>@Model.TransactionNo</strong></span>
                }
            </div>
        </div>

        @if (Model.Booking != null)
        {
            <div class="col-lg-4">
                <div class="eticket-paid-box">
                    <span class="eticket-paid-label">Số tiền đơn hàng</span>
                    <strong class="eticket-paid-amount">@Model.Booking.TotalAmount.ToString("N0") đ</strong>
                    <span class="small d-block mt-2" style="color: #fecaca;">
                        @(Model.CanRetry
                            ? "Đơn chưa thanh toán — ghế vẫn đang được giữ tạm thời."
                            : "Đơn không còn trong thời gian giữ ghế.")
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.Booking != null)
{
    <div class="row g-4 align-items-start">
        <div class="col-lg-7">
            <partial name="_BookingSummary" model="Model.Booking" />
        </div>

        <aside class="col-lg-5">
            @if (Model.CanRetry)
            {
                <div class="card shadow-sm sticky-top" style="top: 1rem;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                            <div>
                                <p class="small text-muted mb-1">Thời gian giữ ghế còn lại</p>
                                <p class="display-6 text-danger mb-0"
                                   data-booking-countdown
                                   data-expires-at="@Model.Booking.ExpiresAt.ToString("O")"
                                   data-server-now="@Model.Booking.ServerNow.ToString("O")">--:--</p>
                            </div>
                            <div class="text-end">
                                <span class="small text-muted d-block">Trạng thái đơn</span>
                                <span class="badge rounded-pill text-bg-warning">Chờ thanh toán</span>
                            </div>
                        </div>

                        <p class="small text-muted mb-3">
                            Bạn chưa được xuất vé cho giao dịch lỗi vừa rồi. Hãy thử thanh toán lại qua VNPay trước khi đồng hồ giữ ghế kết thúc.
                        </p>

                        <form asp-action="Pay" asp-route-id="@Model.Booking.BookingId" method="post">
                            <button type="submit" class="btn btn-primary btn-lg w-100" data-requires-time>
                                Thử thanh toán lại qua VNPay · @Model.Booking.TotalAmount.ToString("N0") đ
                            </button>
                        </form>

                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <a asp-action="Concessions" asp-route-id="@Model.Booking.BookingId" class="btn btn-outline-primary btn-sm w-100">
                                    Sửa bắp &amp; nước
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Movies" asp-action="Seats" asp-route-id="@Model.Booking.ScreeningId" class="btn btn-outline-secondary btn-sm w-100">
                                    Thay đổi ghế
                                </a>
                            </div>
                        </div>

                        <form asp-action="Cancel" asp-route-id="@Model.Booking.BookingId" method="post" class="mt-3 pt-2 border-top">
                            <button type="submit" class="btn btn-link text-danger btn-sm w-100 text-decoration-none">
                                Hủy đơn, nhả ghế đang giữ
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-2">Không thể thử thanh toán lại cho đơn này</h2>
                        <p class="small text-muted mb-3">
                            Thời gian giữ ghế đã hết hoặc đơn đã được hủy, vì vậy ghế đã được giải phóng về trạng thái trống.
                        </p>
                        <div class="d-grid gap-2">
                            <a asp-controller="Movies" asp-action="Seats" asp-route-id="@Model.Booking.ScreeningId" class="btn btn-primary">
                                Chọn ghế lại cho suất chiếu này
                            </a>
                            <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary">
                                Chọn phim khác
                            </a>
                        </div>
                    </div>
                </div>
            }

            <a asp-action="MyBookings" class="d-block mt-3 text-decoration-none">← Xem đơn đặt vé của tôi</a>
        </aside>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">Hướng dẫn xử lý</h2>
            <p class="text-muted mb-3">
                Nếu giao dịch VNPay bị gián đoạn hoặc sai chữ ký bảo mật, bạn có thể kiểm tra lại trạng thái đơn trong mục <strong>Đơn đặt vé của tôi</strong> hoặc chọn suất chiếu mới.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="MyBookings" class="btn btn-primary">Đơn đặt vé của tôi</a>
                <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary">Danh sách phim</a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}

