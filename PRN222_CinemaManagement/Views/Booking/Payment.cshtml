@model BookingDetailsViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<h1 class="h3">Thanh toán đơn hàng</h1>

<div class="alert alert-info">
    Hệ thống sẽ chuyển hướng bạn đến cổng thanh toán <strong>VNPay Sandbox</strong> để hoàn tất giao dịch.
    Vui lòng không tắt trình duyệt trong quá trình thanh toán.
</div>

<div class="row g-4">
    <!-- Cột trái: Tóm tắt đơn hàng -->
    <div class="col-lg-7">
        <partial name="_BookingSummary" model="Model" />
    </div>

    <!-- Cột phải: Phương thức và Nút thanh toán -->
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h2 class="h5 mb-4">Phương thức thanh toán</h2>

                <p class="mb-3">
                    Thời gian giữ ghế còn lại:
                    <strong class="text-danger" data-booking-countdown data-expires-at="@Model.ExpiresAt.ToString("O")" data-server-now="@Model.ServerNow.ToString("O")">--:--</strong>
                </p>

                <img src="https://sandbox.vnpayment.vn/paymentv2/Images/brands/logo-vnpay.png" alt="VNPay Logo" style="height: 50px;" class="mb-4" />

                <!-- Form gửi yêu cầu sang VNPay -->
                <form asp-action="Pay" asp-route-id="@Model.BookingId" method="post">
                    @Html.AntiForgeryToken()

                    <div class="d-grid gap-2">
                        <!-- Nút này sẽ gọi Action Pay (POST) để lấy URL VNPay và chuyển hướng -->
                        <button type="submit" class="btn btn-primary btn-lg" data-requires-time>
                            Thanh toán qua VNPay
                        </button>

                        <!-- Nút Hủy đơn (nếu muốn giữ lại tính năng này) -->
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="document.getElementById('cancel-form').submit();">
                            Hủy thanh toán, nhả ghế
                        </button>
                    </div>
                </form>

                <!-- Form ẩn dùng để gọi API Hủy đơn (nếu bạn có API này) -->
                <form id="cancel-form" asp-action="Cancel" asp-route-id="@Model.BookingId" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                </form>

                <a asp-action="Checkout" asp-route-id="@Model.BookingId" class="d-block mt-4 text-decoration-none">
                    ← Quay lại xác nhận
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}