@model IReadOnlyList<MovieCardViewModel>
@{ ViewData["Title"] = "Phim đang chiếu"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="text-uppercase text-muted mb-1">Cinema Management</p><h1>Phim đang chiếu</h1><p>Chọn phim, chọn suất và đặt chỗ cho buổi xem của bạn.</p></div>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Hiện chưa có phim mở bán. Vui lòng quay lại sau.</div>
}
<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <article class="card h-100">
                @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                {
                    <img src="@movie.PosterUrl" alt="Poster phim @movie.Title" class="card-img-top movie-poster" loading="lazy" />
                }
                else
                {
                    <div class="movie-poster movie-placeholder" aria-hidden="true">CINEMA</div>
                }
                <div class="card-body d-flex flex-column align-items-start">
                    <span class="badge bg-secondary mb-2">@movie.AgeRating · @movie.DurationMinutes phút</span>
                    <h2 class="h4">@movie.Title</h2>
                    <p class="movie-description text-muted">@movie.Description</p>
                    <a asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-primary mt-auto">Xem lịch chiếu</a>
                </div>
            </article>
        </div>
    }
</div>
