@model IEnumerable<ConcessionItem>
@{
    ViewData["Title"] = "Cảnh báo tồn kho thấp (UC-17)";
    int totalAlerts = ViewBag.TotalItems ?? Model.Count();
    int outOfStock = ViewBag.TotalOutOfStock ?? Model.Count(c => c.StockQuantity == 0);
    int lowStock = ViewBag.TotalLowStock ?? Model.Count(c => c.StockQuantity > 0 && c.StockQuantity <= c.LowStockThreshold);
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1">Cảnh báo tồn kho thấp (Low-Stock Alerts)</h2>
        <p class="text-muted mb-0">Danh sách các món ăn/thức uống có số lượng tồn kho &le; ngưỡng cảnh báo tối thiểu.</p>
    </div>
    <div class="d-print-none">
        <a asp-action="Index" class="btn btn-outline-primary me-2">
            &larr; Về quầy bán hàng
        </a>
        <button type="button" onclick="window.print()" class="btn btn-secondary">
            In danh sách
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-danger text-white p-3">
            <div class="small text-uppercase fw-semibold">Món đã hết hàng (0)</div>
            <div class="fs-2 fw-bold">@outOfStock</div>
            <div class="small opacity-75">Cần nhập kho khẩn cấp để mở bán lại</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning text-dark p-3">
            <div class="small text-uppercase fw-semibold">Món sắp hết hàng</div>
            <div class="fs-2 fw-bold">@lowStock</div>
            <div class="small opacity-75">Tồn kho &le; ngưỡng cảnh báo tối thiểu</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-light border p-3">
            <div class="small text-uppercase text-muted fw-semibold">Tổng số mặt hàng cảnh báo</div>
            <div class="fs-2 fw-bold text-dark">@totalAlerts</div>
            <div class="small text-muted">Cần lên kế hoạch nhập hàng</div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success text-center py-4 shadow-sm" role="alert">
        <h5 class="fw-bold mb-2">Tất cả mặt hàng đều có tồn kho an toàn!</h5>
        <p class="text-muted mb-3">Không có món ăn hoặc thức uống nào bị hết hàng hoặc dưới ngưỡng cảnh báo tối thiểu.</p>
        <a asp-action="Index" class="btn btn-success">&larr; Quay lại quầy bán bắp nước</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white py-2">
            <h5 class="mb-0 fs-6 fw-semibold">Chi tiết mặt hàng cần bổ sung tồn kho</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Tên món ăn / thức uống</th>
                        <th>Mô tả</th>
                        <th style="width: 130px;" class="text-end">Đơn giá</th>
                        <th style="width: 130px;" class="text-center">Tồn kho hiện tại</th>
                        <th style="width: 140px;" class="text-center">Ngưỡng cảnh báo</th>
                        <th style="width: 160px;" class="text-center">Mức độ cảnh báo</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = (currentPage - 1) * pageSize + 1; }
                    @foreach (var item in Model)
                    {
                        bool isOutOfStock = item.StockQuantity == 0;
                        <tr class="@(isOutOfStock ? "table-danger" : "table-warning")">
                            <td class="text-center text-muted">@(stt++)</td>
                            <td>
                                <strong>@item.Name</strong>
                            </td>
                            <td class="text-muted small">@(item.Description ?? "-")</td>
                            <td class="text-end fw-semibold">@item.Price.ToString("N0") đ</td>
                            <td class="text-center fw-bold fs-6">
                                @item.StockQuantity
                            </td>
                            <td class="text-center text-muted">
                                @item.LowStockThreshold
                            </td>
                            <td class="text-center">
                                @if (isOutOfStock)
                                {
                                    <span class="badge bg-danger">Hết hàng (Cần nhập)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Sắp hết hàng</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 d-print-none">
                <div class="text-muted small">
                    Hiển thị @(((currentPage - 1) * pageSize) + 1) - @Math.Min(currentPage * pageSize, totalAlerts) trên tổng số @totalAlerts mặt hàng
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="LowStock" asp-route-page="@(currentPage - 1)">&laquo; Trước</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="LowStock" asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="LowStock" asp-route-page="@(currentPage + 1)">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="card-footer bg-white text-muted small py-2 d-print-none">
                Hiển thị @totalAlerts / @totalAlerts mặt hàng cảnh báo
            </div>
        }
    </div>
}

<style>
    @@media print {
        header, footer, .d-print-none, .alert {
            display: none !important;
        }
        body {
            background-color: white !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }
    }
</style>
