@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang chủ";
    var username = Context.Session.GetString("Username");
    var fullName = Context.Session.GetString("FullName") ?? username;
    var role = Context.Session.GetString("Role");
    bool isLoggedIn = !string.IsNullOrEmpty(username);
}

<div class="py-4">
    @if (isLoggedIn)
    {
        <div class="alert alert-secondary py-2 mb-4">
            Đang đăng nhập: <strong>@fullName</strong> | Vai trò: <strong>@role</strong>
        </div>

        <div class="d-flex gap-2">
            @if (role == "Admin")
            {
                <a asp-controller="Employee" asp-action="Index" class="btn btn-primary">Quản lý nhân viên</a>
            }
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Hồ sơ cá nhân</a>
        </div>
    }
    else
    {
        <p>Vui lòng đăng nhập để sử dụng hệ thống.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Đăng nhập</a>
    }
</div>
