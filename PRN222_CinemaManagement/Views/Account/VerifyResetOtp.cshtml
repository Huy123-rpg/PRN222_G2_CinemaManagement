@model VerifyResetOtpViewModel
@{
    ViewData["Title"] = "Xác thực mã OTP";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary p-3 rounded-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.134a.1.1 0 0 0 .101.006c.015-.006.087-.044.298-.14a10 10 0 0 0 .886-.528 10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                            <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                        </svg>
                    </span>
                </div>

                <h3 class="card-title h4 mb-2">Xác thực mã OTP</h3>
                <p class="text-muted small mb-3">
                    Mã xác thực (OTP) 6 chữ số đã được gửi tới email:<br />
                    <strong class="text-dark">@(Model.Email ?? "email của bạn")</strong>
                </p>

                @if (TempData["DemoOtp"] != null)
                {
                    <div class="alert alert-warning text-start py-2 small mb-3">
                        <div class="fw-bold mb-1">Mã xác thực thử nghiệm (Demo/Dev):</div>
                        <div>Chưa cài đặt tài khoản gửi email thật trong <code>appsettings.json</code>. Mã OTP của bạn là: <strong class="fs-6 text-primary">@TempData["DemoOtp"]</strong></div>
                    </div>
                }

                <form asp-action="VerifyResetOtp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label visually-hidden">Mã xác thực OTP</label>
                        <input asp-for="OtpCode" class="form-control form-control-lg text-center fw-bold fs-3"
                               style="letter-spacing: 8px;"
                               placeholder="------"
                               maxlength="6"
                               autocomplete="one-time-code"
                               autofocus />
                        <span asp-validation-for="OtpCode" class="text-danger small mt-1 d-block text-start"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                        Xác nhận OTP
                    </button>
                </form>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top small">
                    <form asp-action="ResendResetOtp" method="post" class="d-inline" id="resendResetOtpForm">
                        <button type="submit" class="btn btn-link p-0 text-decoration-none small" id="resendOtpBtn">
                            Gửi lại mã OTP
                        </button>
                    </form>
                    <a asp-action="ForgotPassword" class="text-secondary text-decoration-none">Nhập lại email</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof initOtpCooldown === "function") {
                initOtpCooldown("resendOtpBtn", 60);
            }
        });
    </script>
}
