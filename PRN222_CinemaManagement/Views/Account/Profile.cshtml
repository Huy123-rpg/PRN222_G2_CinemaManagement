@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-7">
        <h3 class="mb-3">Hồ sơ cá nhân</h3>
        <hr />
        <table class="table table-bordered align-middle">
            <tbody>
                <tr>
                    <th class="w-30 text-muted">Tên đăng nhập</th>
                    <td>@Model.Username</td>
                </tr>
                <tr>
                    <th class="text-muted">Họ và tên</th>
                    <td>@Model.FullName</td>
                </tr>
                <tr>
                    <th class="text-muted">Mã định danh</th>
                    <td>@(Model.UserCode ?? "-")</td>
                </tr>
                <tr>
                    <th class="text-muted">Email</th>
                    <td>@Model.Email</td>
                </tr>
                <tr>
                    <th class="text-muted">Số điện thoại</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</td>
                </tr>
                <tr>
                    <th class="text-muted">Vai trò</th>
                    <td>@Model.RoleName</td>
                </tr>
                <tr>
                    <th class="text-muted">Trạng thái</th>
                    <td>@Model.Status</td>
                </tr>
                <tr>
                    <th class="text-muted">Ngày tạo</th>
                    <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") (UTC)</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a asp-action="UpdateProfile" class="btn btn-primary me-2">Cập nhật thông tin</a>
            <a asp-action="ChangePassword" class="btn btn-outline-secondary">Đổi mật khẩu</a>
        </div>
    </div>
</div>
