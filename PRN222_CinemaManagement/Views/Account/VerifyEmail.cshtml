@model VerifyEmailViewModel
@{
    ViewData["Title"] = "Xác thực email";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary p-3 rounded-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-envelope-check" viewBox="0 0 16 16">
                            <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.2V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2zm3.708 6.208L1 11.105V5.383zM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v.217l-7 4.2z"/>
                            <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.549-.549a.5.5 0 1 0-.708.708l1 1a.5.5 0 0 0 .76-.062l1.5-2.5a.5.5 0 0 0-.147-.669"/>
                        </svg>
                    </span>
                </div>

                <h3 class="card-title h4 mb-2">Xác thực Email</h3>
                <p class="text-muted small mb-4">
                    Chúng tôi đã gửi mã xác thực (OTP) 6 chữ số tới:<br />
                    <strong class="text-dark">@(Model.Email ?? "email của bạn")</strong>
                </p>

                @if (TempData["DemoOtp"] != null)
                {
                    <div class="alert alert-warning text-start py-2 small mb-3">
                        <div class="fw-bold mb-1">Mã xác thực thử nghiệm (Demo/Dev):</div>
                        <div>Chưa cài đặt tài khoản gửi email thật trong <code>appsettings.json</code>. Mã OTP của bạn là: <strong class="fs-6 text-primary">@TempData["DemoOtp"]</strong></div>
                    </div>
                }

                <form asp-action="VerifyEmail" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label visually-hidden">Mã xác thực OTP</label>
                        <input asp-for="OtpCode" class="form-control form-control-lg text-center fw-bold fs-3"
                               style="letter-spacing: 8px;"
                               placeholder="------"
                               maxlength="6"
                               autocomplete="one-time-code"
                               autofocus />
                        <span asp-validation-for="OtpCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                        Xác nhận & Hoàn tất đăng ký
                    </button>
                </form>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top small">
                    <form asp-action="ResendOtp" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link p-0 text-decoration-none small">
                            Gửi lại mã OTP
                        </button>
                    </form>
                    <a asp-action="Register" class="text-secondary text-decoration-none">Nhập lại thông tin</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
