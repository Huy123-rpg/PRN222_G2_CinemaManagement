@model EditEmployeeViewModel
@{
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-7">
        <h3 class="mb-3">Chỉnh sửa nhân viên & Phân quyền</h3>
        <hr />
        <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Username" />
            <input type="hidden" asp-for="EmployeeCode" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-muted">Tên đăng nhập</label>
                    <input class="form-control" value="@Model.Username" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted">Mã nhân viên</label>
                    <input class="form-control" value="@Model.EmployeeCode" readonly />
                </div>

                <div class="col-md-12">
                    <label asp-for="FullName" class="form-label">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="RoleId" class="form-label">Vai trò</label>
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select"></select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">Trạng thái</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Locked">Locked</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
